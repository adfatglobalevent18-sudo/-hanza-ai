# Copy this file to .env on the SERVER only.
# Put your private API key here. Never paste it into frontend/index.html or a public repository.
OPENAI_API_KEY=replace_with_your_private_key
OPENAI_MODEL=gpt-4.1-mini
PORT=3000

# In production, set this to your exact deployed website origin, e.g.
# CORS_ORIGIN=https://your-real-domain.example
CORS_ORIGIN=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

